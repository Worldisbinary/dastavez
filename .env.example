# Copy to .env and fill in what you need. Never commit .env.

# PostgreSQL with the pgvector extension. Unset => in-process index (dev/tests).
# DASTAVEZ_DATABASE_URL=postgresql://dastavez:dastavez@localhost:5432/dastavez

# Gemini (optional). Set => LLM answers (still verified). Unset => extractive answers.
# GEMINI_API_KEY=
# DASTAVEZ_GEMINI_MODEL=gemini-2.5-flash
# DASTAVEZ_GEMINI_EMBED_MODEL=gemini-embedding-001

# Embedder: auto | fastembed | gemini | hash
# DASTAVEZ_EMBEDDER=auto
# DASTAVEZ_EMBED_MODEL=intfloat/multilingual-e5-large

# Reranker: auto | cross-encoder | lexical | none
# DASTAVEZ_RERANKER=auto
# DASTAVEZ_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8

# OCR
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DASTAVEZ_OCR_DPI=300

# Paths (defaults are relative to the working directory)
# DASTAVEZ_HOME=.
# DASTAVEZ_PDF_DIR=./corpus/pdfs
# DASTAVEZ_DATA_DIR=./data
# DASTAVEZ_MODEL_CACHE=./.cache/fastembed
